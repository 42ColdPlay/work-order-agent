# ============================================================
# 本地配置模板：复制为 application-local.yml 后填入真实值
# application-local.yml 已被 .gitignore 忽略，不会进入仓库
# ============================================================

spring:
  datasource:
    username: root
    password: your-mysql-password

  data:
    redis:
      password: your-redis-password

# 用 openssl rand -base64 64 生成
jwt:
  secret: your-base64-secret

# 使用 deepseek profile 时放开下面这行
# DEEPSEEK_API_KEY: sk-your-key
